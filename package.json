{
  "name": "youtube-shorts-generator",
  "version": "1.0.0",
  "description": "YouTube Shorts Generator \u2014 Desktop Electron App",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "tsc",
    "build:all": "tsc && tsc electron/main.ts electron/preload.ts --outDir dist/electron --esModuleInterop --target ES2022 --moduleResolution node --module commonjs --skipLibCheck",
    "start": "electron .",
    "dev": "vite --config electron/renderer/vite.config.ts",
    "lint": "eslint src --ext .ts,.tsx",
    "package": "npm run build:all && electron-builder",
    "package:win": "npm run build:all && electron-builder --win",
    "demo": "node demo/run-demo.js"
  },
  "dependencies": {
    "electron": "^33.0.0",
    "better-sqlite3": "^9.4.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.0",
    "fluent-ffmpeg": "^2.1.2",
    "js-yaml": "^4.1.0",
    "openai": "^4.52.0",
    "@anthropic-ai/sdk": "^0.18.0",
    "googleapis": "^140.0.0",
    "ora": "^8.0.0",
    "winston": "^3.11.0",
    "ytdl-core": "^4.11.0",
    "chalk": "^4.1.0",
    "express": "^4.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "electron-builder": "^24.13.0",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/node": "^20.0.0",
    "@types/better-sqlite3": "^7.6.0"
  },
  "build": {
    "appId": "com.georgewebdev.youtubeshorts",
    "productName": "YouTube Shorts Generator",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}